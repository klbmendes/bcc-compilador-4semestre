#Options
GenerateScanner = true
GenerateParser = true
Language = Java
ScannerName = Lexico
ParserName = Sintatico
SemanticName = Semantico
ScannerCaseSensitive = true
ScannerTable = Compact
Input = Stream
Parser = LL
#RegularDefinitions

min: [a-z]



dig: [0-9]

charaux: n|s|t

linha: # [^\n]*

bloco: \{\n[^\{\}]*\n\}

#Tokens
//identificador
id:! {min} ({min} | _{dig} + )*
cte_int:! {dig}+
cte_float:! {dig}+ \. {dig}+
cte_char:! \\{charaux}
cte_string:! \"([^\n\"\\%] | %x) *\" 


//palavras reservadas
pr_ask = id:"ask"
pr_bool = id:"bool"
pr_char = id:"char"
pr_define = id:"define"
pr_end = id:"end"
pr_elif = id:"elif"
pr_else = id:"else"
pr_false =id: "false"
pr_float =id: "float"
pr_if = id:"if"
pr_int = id:"int"
pr_main = id:"main"
pr_repeat = id:"repeat"
pr_string = id:"string"
pr_tell = id:"tell"
pr_true = id:"true"
pr_until = id:"until"
pr_while = id:"while"


//simbolos especiais 
":"
";"
","
"="
"<-"
"("
")"
"&&"
"||"
"!"
"=="
"!="
"<"
"<="
">"
">="
"+"
"-"
"*"
"/"
"^"

//caracteres de formatacao
:[\s\n\t]


//comentarios
:! {linha}
:! {bloco}


#NonTerminals
<main>
<opcional_main>
<lista_instrucoes>
<lista_instrucoes_>
<instrucao>
<dec_variaveis>
<lista_id>
<lista_id_>
<tipo>
<dec_atribuicao>
<dec_atribuicao_>
<dec_entrada>
<lista_entrada>
<lista_entrada_>
<opcional_atribuicao>
<dec_saida>
<lista_expressao>
<lista_expressao_>
<dec_selecao>
<elif_selecao>
<opcional_selecao>
<dec_loop>
<dec_loop_>
<repete>
<expressao>
<expressao_>
<termo_logico>
<relacional>
<relacional_>
<operador_relacional>
<aritmetica>
<aritmetica_>
<termo_aritmetico>
<termo_aritmetico_>
<fator>
<fator_>
<elemento>

#Grammar
<main> ::= pr_main <opcional_main> <lista_instrucoes> pr_end ;
<opcional_main> ::= <dec_variaveis> | î ;

// <lista_instrucoes> ::= <instrucao> ";" | <instrucao> ";" <lista_instrucoes> ;

<lista_instrucoes> ::= <instrucao> ";" <lista_instrucoes_> ;
<lista_instrucoes_> ::= î | <lista_instrucoes> ;

<instrucao> ::= <dec_atribuicao> | <dec_entrada> | <dec_saida> | <dec_selecao> | <dec_loop> ;
<dec_variaveis> ::= pr_define <tipo> ":" <lista_id> ";" <repete> ;
<repete> ::= î | <tipo> ":" <lista_id> ";" <repete> ;

// <lista_id> ::= id | id "," <lista_id> ;
<lista_id> ::= id <lista_id_> ;
<lista_id_> ::= î | "," <lista_id> ;

<tipo> ::= pr_bool | pr_char | pr_int | pr_float | pr_string ;

// <dec_atribuicao> ::= <lista_id> "=" <expressao> | <lista_id> "<-" <expressao> ;
<dec_atribuicao> ::= <lista_id> <dec_atribuicao_> ;
<dec_atribuicao_> ::= "=" <expressao> | "<-" <expressao> ;

<dec_entrada> ::= pr_ask "(" <lista_entrada> ")" ;

// <lista_entrada> ::= <opcional_atribuicao> id | <opcional_atribuicao> id "," <lista_entrada> ;
<lista_entrada> ::= <opcional_atribuicao> id <lista_entrada_> ;
<lista_entrada_> ::= î | "," <lista_entrada> ;


<opcional_atribuicao> ::= cte_string "," | î ;
<dec_saida> ::= pr_tell "(" <lista_expressao> ")" ; 

// <lista_expressao> ::= <expressao> | <expressao> "," <lista_expressao> ;
<lista_expressao> ::= <expressao> <lista_expressao_> ;
<lista_expressao_> ::= î |  "," <lista_expressao> ;

<dec_selecao> ::=  pr_if <expressao> <lista_instrucoes> <elif_selecao> <opcional_selecao> pr_end  ;
<elif_selecao> ::= î | pr_elif <expressao> <lista_instrucoes> <elif_selecao> ;
<opcional_selecao> ::= pr_else <lista_instrucoes> | î ;

// <dec_loop> ::= pr_repeat <lista_instrucoes> pr_until <expressao> | pr_repeat <lista_instrucoes> pr_while <expressao> ;
<dec_loop> ::= pr_repeat <lista_instrucoes> <dec_loop_> <expressao> ;
<dec_loop_> ::= pr_until | pr_while ;


// Trabalho 03 (Professora)

<expressao> ::= <termo_logico> <expressao_> ;
<expressao_> ::= î | "&&" <termo_logico> <expressao_> | "||" <termo_logico> <expressao_> ;
<termo_logico> ::= <relacional> | pr_true | pr_false | "!" <termo_logico> ;
<relacional> ::= <aritmetica> <relacional_> ;
<relacional_> ::= î | <operador_relacional> <aritmetica> ;
<operador_relacional>::= "==" | "!=" | "<" | "<=" | ">" |">=" ;
<aritmetica> ::= <termo_aritmetico> <aritmetica_> ;
<aritmetica_> ::= î | "+" <termo_aritmetico> <aritmetica_> |
 "-" <termo_aritmetico> <aritmetica_> ;
<termo_aritmetico> ::= <fator> <termo_aritmetico_> ;
<termo_aritmetico_> ::= î | "*" <fator> <termo_aritmetico_> | "/" <fator> <termo_aritmetico_> ;
<fator> ::= <elemento> <fator_> ;
<fator_> ::= î | "^" <elemento> <fator_> ;
<elemento> ::= id |
 cte_int |
 cte_float |
 cte_char |
 cte_string |
 "(" <expressao> ")" |
 "+" <elemento> |
 "-" <elemento> ;

